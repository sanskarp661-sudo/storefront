# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# ERP API key. Also the HMAC secret the ERP uses to sign webhooks.
ERP_API_KEY=
# ERP API base URL (trailing slash optional)
ERP_API_BASE_URL=https://erp.mosaicengine.in/api/v1/
# Postgres connection string (Neon / Supabase / Vercel Postgres; use the pooled URL on serverless)
DATABASE_URL=postgres://user:password@host:5432/storefront?sslmode=require
# Shared secret for /api/cron/sync (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=

# --- Public (safe for the browser) ---
NEXT_PUBLIC_STORE_NAME=Mosaic Store
NEXT_PUBLIC_SUPPORT_EMAIL=sanskar@mosaicengine.in

# Payment methods offered at checkout, comma-separated (first is the default). Currently: cod
PAYMENT_METHODS=cod
